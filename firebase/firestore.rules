rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }
    function validProfile(uid) {
      return owns(uid)
        && request.resource.data.keys().hasOnly(['username', 'createdAt'])
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.createdAt == request.time;
    }
    function validUsernameReservation(username) {
      return signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'username', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == username
        && request.resource.data.username.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.createdAt == request.time;
    }
    function validBookmark(id) {
      return request.resource.data.keys().hasOnly(['mangaId', 'manga', 'updatedAt'])
        && request.resource.data.mangaId == id
        && request.resource.data.manga is map
        && request.resource.data.updatedAt == request.time;
    }
    function validProgress() {
      return request.resource.data.keys().hasOnly([
        'mangaId','chapterId','pageIndex','relativeOffset','chapterProgress',
        'openedChapterIds','updatedAt'
      ])
        && request.resource.data.mangaId is string
        && request.resource.data.chapterId is string
        && request.resource.data.pageIndex is int
        && request.resource.data.pageIndex >= 0
        && request.resource.data.relativeOffset is number
        && request.resource.data.relativeOffset >= 0
        && request.resource.data.relativeOffset <= 1
        && request.resource.data.chapterProgress is number
        && request.resource.data.chapterProgress >= 0
        && request.resource.data.chapterProgress <= 1
        && request.resource.data.openedChapterIds is list
        && request.resource.data.openedChapterIds.size() <= 2000
        && request.resource.data.updatedAt == request.time;
    }

    match /manga/{mangaId} {
      allow read: if signedIn();
      allow write: if false;
      match /chapters/{chapterId} {
        allow read: if signedIn();
        allow write: if false;
      }
    }
    match /rankings/{period} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /usernames/{username} {
      allow read: if signedIn();
      allow create: if !exists(/databases/$(database)/documents/usernames/$(username))
        && validUsernameReservation(username);
      allow update: if resource.data.uid == request.auth.uid
        && validUsernameReservation(username);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
    match /users/{uid} {
      allow read, delete: if owns(uid);
      allow create, update: if validProfile(uid);
      match /bookmarks/{mangaId} {
        allow read, delete: if owns(uid);
        allow create, update: if owns(uid) && validBookmark(mangaId);
      }
      match /progress/{mangaId} {
        allow read, delete: if owns(uid);
        allow create, update: if owns(uid) && validProgress()
          && request.resource.data.mangaId == mangaId;
      }
      match /{privateCollection}/{document=**} {
        allow read, write: if false;
      }
    }
    match /internalSourceMappings/{document=**} { allow read, write: if false; }
    match /trackedManga/{document=**} { allow read, write: if false; }
    match /sourceHealth/{document=**} { allow read, write: if false; }
    match /updateJobs/{document=**} { allow read, write: if false; }
    match /mergeAudit/{document=**} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
